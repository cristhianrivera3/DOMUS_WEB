# URL base de la API de catálogo (opcional).
# Si se omite, la app usa los datos estáticos de src/data.
VITE_API_URL=

# Endpoint para el envío de leads del formulario de contacto (opcional).
# Si se omite, el formulario solo abre WhatsApp.
VITE_LEADS_URL=

# Dominio de Plausible para analytics (opcional).
# Solo se carga después de que el usuario acepta cookies.
VITE_ANALYTICS_DOMAIN=
